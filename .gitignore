.env
.env.*
!.env.example

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files (not sure if needed?)
.DS_Store
Thumbs.db

# Typescript declaration files
*.d.ts
